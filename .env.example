# LLM Configuration
# Set IS_VERTEX to True for Vertex AI, False for Gemini API
# Both use google-genai SDK - just different authentication methods
IS_VERTEX=False

# Gemini API Configuration (used when IS_VERTEX=False)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Google Cloud Vertex AI Configuration (used when IS_VERTEX=True)
# Vertex AI uses Application Default Credentials (ADC)
# Set GOOGLE_APPLICATION_CREDENTIALS to your service account JSON file path
GOOGLE_APPLICATION_CREDENTIALS="./bettrlabs-vertex-ai.json"

# Vertex AI Project Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"

# LLM Model Configuration
# Works with both Gemini API and Vertex AI
VALIDATION_MODEL="gemini-3.1-flash-lite-preview"
ANALYSIS_MODEL="gemini-3-flash-preview"
METADATA_EXTRACTION_MODEL="gemini-3.1-flash-lite-preview"
OCR_EXTRACTION_MODEL="gemini-3-flash-preview"
CLAIMS_VALIDATION_MODEL="gemini-3-flash-preview"
NUTRITION_VALIDATION_MODEL="gemini-3.1-flash-lite-preview"
LABTEST_SUGGESTION_MODEL="gemini-3-flash-preview"
CATEGORY_PREDICTION_MODEL="gemini-3.1-flash-lite-preview"

# Server Configuration
HOST="0.0.0.0"
PORT="8000"

# Logging Configuration
LOG_LEVEL="INFO"

# CORS Allowed Origins (Comma-separated for multiple)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
